# Skopiuj do .env:  cp .env.example .env   i zmień wartości.
# Plik .env NIE trafia do repozytorium (.gitignore).

# --- PostgreSQL ---
POSTGRES_DB=domradar
POSTGRES_USER=domradar
POSTGRES_PASSWORD=change-me-db-password

# --- RabbitMQ ---
RABBITMQ_USER=domradar
RABBITMQ_PASSWORD=change-me-rabbit-password

# --- Bezpieczeństwo ---
# Min. 32 znaki, losowy ciąg (np. `openssl rand -base64 48`)
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
# Konto administratora tworzone przy starcie, jeśli nie istnieje
ADMIN_EMAIL=admin@domradar.local
ADMIN_PASSWORD=change-me-admin-password
# Opcjonalne konto demo z rolą USER (puste = nie twórz)
DEMO_USER_EMAIL=user@domradar.local
DEMO_USER_PASSWORD=change-me-user-password

# --- Aplikacja ---
APP_PUBLIC_URL=http://localhost:3080
MAIL_FROM=alerty@domradar.local
# Pierwszy import przy starcie, jeśli baza jest pusta
APP_BOOTSTRAP_IMPORT=true

# --- Źródła danych ---
# Prawdziwe ogłoszenia z Otodom i OLX (robots.txt, limit żądań, tylko strony wyników).
# Przed włączeniem przeczytaj sekcję "Aspekt prawny źródeł danych" w README.
LIVE_SOURCES_ENABLED=true
# Liczba stron wyników na miasto i rodzaj transakcji (najnowsze ogłoszenia), max 10
LIVE_MAX_PAGES=2
# Miasta (slugi ze słownika, po przecinku); puste = warszawa,krakow,wroclaw,gdansk,poznan,lodz
LIVE_CITIES=
# Identyfikujący User-Agent; możesz dopisać adres kontaktowy projektu
LIVE_USER_AGENT=DomRadarBot/1.0 (projekt studencki; agregator ogloszen)
# Dane syntetyczne (DemoAdapter + snapshoty) — działają offline; ustaw true, aby je włączyć
DEMO_DATA_ENABLED=false

# --- Porty na hoście ---
FRONTEND_PORT=3080
BACKEND_PORT=8080
POSTGRES_PORT=55432
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
